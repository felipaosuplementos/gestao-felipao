rules_version = '2';

// Só a conta Google do Felipão lê e grava, e só dentro da pasta dela.
// E só nas partes que o sistema usa (produtos, clientes, vendas…): qualquer outra coisa é bloqueada.
service cloud.firestore {
  match /databases/{database}/documents {
    function ehFelipao(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'passossuplementos@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /usuarios/{uid}/{loja}/{id} {
      allow read, delete: if ehFelipao(uid) && loja in ['produtos', 'movimentos', 'fotos', 'clientes', 'lancamentos', 'vendas', 'tarefas', 'pedidos', 'ajustes'];
      // Gravação: só nas partes do sistema e sempre com a marca de sincronização.
      allow create, update: if ehFelipao(uid)
        && loja in ['produtos', 'movimentos', 'fotos', 'clientes', 'lancamentos', 'vendas', 'tarefas', 'pedidos', 'ajustes']
        && request.resource.data.keys().hasAll(['_sync', '_origem']);
    }
  }
}
